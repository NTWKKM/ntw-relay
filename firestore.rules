rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Primitives
    function hasAuth() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return hasAuth()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data.role == 'admin'
        && get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data.status == 'approved';
    }

    function isApprovedUser() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data.status == 'approved';
    }

    function isSignedIn() {
      return isApprovedUser();
    }

    function isVerified() {
      return isApprovedUser();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(email) {
      return email is string
        && email.size() >= 3
        && email.size() <= 320
        && email == email.lower()
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /drops/{dropId}
    // Document ID: 1..128 chars [a-zA-Z0-9_-]
    // Fields:
    //   - ownerId: string (required, immutable, == request.auth.uid)
    //   - type: string (required, 'text' | 'image' | 'file')
    //   - content: string (required, <= 50000)
    //   - fileName: string (optional, <= 255)
    //   - fileSize: number (optional, 0..10485760 [10 MiB])
    //   - mimeType: string (optional, <= 128)
    //   - chunkCount: int (optional, 0..14)
    //   - previewDataUrl: string (optional, <= 160000, JPEG base64 data URL)
    //   - isCode: bool (optional, mutable by owner)
    //   - counted: bool (required true on create, immutable; marks bytes as recorded in /stats/storage.
    //     Pre-counter legacy drops lack it and are deleted without touching /stats/storage.)
    //   - createdAt: timestamp (required, immutable, == request.time on create)
    //
    // Subcollection: /drops/{dropId}/chunks/{chunkId}
    // Document ID: ^[0-9]{1,2}$ matching string(index) ('0'..'13')
    // Note: Chunks are written before the parent /drops/{dropId} document exists,
    // so create rules do not require get() of the parent document.
    // Fields:
    //   - ownerId: string (required, == request.auth.uid)
    //   - index: int (required, 0..13)
    //   - data: bytes (required, size 1..786432 [768 KiB])
    //
    // Document: /stats/storage (singleton)
    // Fields:
    //   - totalBytes: int (required, 0..10737418240 [10 GiB], exact dropStorageBytes delta clamped to 11000000 per op)
    //   - lastDropId: string (required, 1..128 chars [a-zA-Z0-9_-], proves atomic drop create/delete)
    //   - updatedAt: timestamp (required, == request.time on create and update)
    //
    // Collection: /allowed_users/{email}
    // Document ID: lowercase email (3..320 chars, ^[^@\s]+@[^@\s]+\.[^@\s]+$)
    // Fields:
    //   - email: string (required, immutable, == email doc ID)
    //   - status: string (required, 'pending' | 'approved' | 'rejected')
    //   - role: string (required, 'admin' | 'user')
    //   - uid: string (optional, 1..128 chars)
    //   - displayName: string (optional, <= 128 chars)
    //   - requestedAt: timestamp (optional, == request.time on self-request)
    //   - updatedAt: timestamp (required, == request.time on create and update)
    //   - reviewedBy: string (optional, <= 320 chars)
    //
    // ===============================================================

    // Pillar 2: Validation Blueprint (Firestore-only chunked storage)
    function isValidDrop(data) {
      return data.keys().hasAll(['ownerId', 'type', 'content', 'createdAt'])
        && data.keys().hasOnly([
          'ownerId',
          'type',
          'content',
          'fileName',
          'fileSize',
          'mimeType',
          'chunkCount',
          'previewDataUrl',
          'isCode',
          'counted',
          'createdAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.type in ['text', 'image', 'file']
        && data.content is string
        && data.content.size() <= 50000
        && data.createdAt is timestamp
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255))
        && (!('fileSize' in data) || (data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 10485760))
        && (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 128))
        && (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 14))
        && (!('previewDataUrl' in data) || (data.previewDataUrl is string && data.previewDataUrl.size() <= 160000 && data.previewDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && (!('isCode' in data) || (data.isCode is bool))
        && (!('counted' in data) || (data.counted is bool));
    }

    function isValidChunk(data, chunkId) {
      return data.keys().hasAll(['ownerId', 'index', 'data'])
        && data.keys().hasOnly(['ownerId', 'index', 'data'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.index is int
        && data.index >= 0
        && data.index <= 13
        && chunkId.matches('^[0-9]{1,2}$')
        && chunkId == string(data.index)
        && data.data is bytes
        && data.data.size() >= 1
        && data.data.size() <= 786432;
    }

    function isValidStorageStats(data) {
      return data.keys().hasAll(['totalBytes', 'lastDropId', 'updatedAt'])
        && data.keys().hasOnly(['totalBytes', 'lastDropId', 'updatedAt'])
        && data.totalBytes is int
        && data.totalBytes >= 0
        && data.totalBytes <= 10737418240
        && data.lastDropId is string
        && isValidId(data.lastDropId)
        && data.updatedAt is timestamp;
    }

    function isValidAllowedUser(data, email) {
      return data.keys().hasAll(['email', 'status', 'role', 'updatedAt'])
        && data.keys().hasOnly([
          'email',
          'status',
          'role',
          'uid',
          'displayName',
          'requestedAt',
          'updatedAt',
          'reviewedBy'
        ])
        && isValidEmailId(email)
        && data.email is string
        && data.email == email
        && data.status in ['pending', 'approved', 'rejected']
        && data.role in ['admin', 'user']
        && data.updatedAt is timestamp
        && (!('uid' in data) || (data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('requestedAt' in data) || (data.requestedAt is timestamp))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 320));
    }

    function minInt(a, b) {
      return a < b ? a : b;
    }

    function maxInt(a, b) {
      return a > b ? a : b;
    }

    function dropStorageBytes(d) {
      return minInt(
        11000000,
        ('fileSize' in d ? int(d.fileSize) : 0)
          + d.content.toUtf8().size()
          + ('previewDataUrl' in d ? d.previewDataUrl.size() : 0)
      );
    }

    function isAtomicDropCreate(dropId) {
      return !exists(/databases/$(database)/documents/drops/$(dropId))
        && existsAfter(/databases/$(database)/documents/drops/$(dropId))
        && getAfter(/databases/$(database)/documents/drops/$(dropId)).data.ownerId == request.auth.uid;
    }

    function isAtomicDropDelete(dropId) {
      return exists(/databases/$(database)/documents/drops/$(dropId))
        && !existsAfter(/databases/$(database)/documents/drops/$(dropId))
        && get(/databases/$(database)/documents/drops/$(dropId)).data.ownerId == request.auth.uid;
    }

    // Proves /stats/storage is written in this same request and attributed to dropId
    function isStatsWrittenFor(dropId) {
      return existsAfter(/databases/$(database)/documents/stats/storage)
        && getAfter(/databases/$(database)/documents/stats/storage).data.lastDropId == dropId
        && getAfter(/databases/$(database)/documents/stats/storage).data.updatedAt == request.time;
    }

    // Personal Drop Collection: Private Single-Owner Drops
    match /drops/{dropId} {
      // Single-document read: strict owner isolation + Path ID hardening (allows missing-doc get for idempotent deletes)
      allow get: if isSignedIn()
        && isValidId(dropId)
        && (resource == null || existing().ownerId == request.auth.uid);

      // Pillar 8: Secure List Query (no isValidId, no get(), strict rule-side owner filter)
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      // Create: Auth -> Static Validation -> Temporal Integrity
      allow create: if isVerified()
        && isValidId(dropId)
        && isValidDrop(incoming())
        && incoming().createdAt == request.time
        && incoming().get('counted', false) == true
        && isStatsWrittenFor(dropId);

      // Pillar 4 & 5: Action-Based Update (only toggling isCode; ownerId & createdAt immutable)
      allow update: if isVerified()
        && isValidId(dropId)
        && isValidDrop(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isCode']);

      // Delete: Verified owner only + Path ID hardening; counted drops must decrement /stats/storage atomically
      allow delete: if isVerified()
        && isValidId(dropId)
        && existing().ownerId == request.auth.uid
        && (existing().get('counted', false) != true || isStatsWrittenFor(dropId));

      // Chunked Binary Storage Subcollection (written before parent drop doc)
      match /chunks/{chunkId} {
        allow get: if isSignedIn()
          && isValidId(dropId)
          && chunkId.matches('^[0-9]{1,2}$')
          && existing().ownerId == request.auth.uid;

        allow list: if isSignedIn()
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(dropId)
          && isValidChunk(incoming(), chunkId);

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(dropId)
          && chunkId.matches('^[0-9]{1,2}$')
          && existing().ownerId == request.auth.uid;
      }
    }

    // Global Aggregate Storage Counter (Singleton)
    match /stats/storage {
      allow get: if isSignedIn();

      allow list: if false;

      allow create: if isVerified()
        && isValidStorageStats(incoming())
        && incoming().updatedAt == request.time
        && isAtomicDropCreate(incoming().lastDropId)
        && incoming().totalBytes == dropStorageBytes(getAfter(/databases/$(database)/documents/drops/$(incoming().lastDropId)).data);

      allow update: if isVerified()
        && isValidStorageStats(incoming())
        && existing().totalBytes is int
        && incoming().updatedAt == request.time
        && (
          (
            isAtomicDropCreate(incoming().lastDropId)
            && incoming().totalBytes == minInt(
              10737418240,
              existing().totalBytes + dropStorageBytes(getAfter(/databases/$(database)/documents/drops/$(incoming().lastDropId)).data)
            )
          )
          || (
            isAtomicDropDelete(incoming().lastDropId)
            && get(/databases/$(database)/documents/drops/$(incoming().lastDropId)).data.get('counted', false) == true
            && incoming().totalBytes == maxInt(
              0,
              existing().totalBytes - dropStorageBytes(get(/databases/$(database)/documents/drops/$(incoming().lastDropId)).data)
            )
          )
        );

      allow delete: if false;
    }

    // Email-Based Allowlist Collection
    match /allowed_users/{email} {
      allow get: if isAdmin()
        || (hasVerifiedEmail() && request.auth.token.email.lower() == email);

      allow list: if isAdmin();

      allow create: if (
        isAdmin()
        && isValidAllowedUser(incoming(), email)
        && incoming().updatedAt == request.time
      ) || (
        hasVerifiedEmail()
        && request.auth.token.email.lower() == email
        && isValidAllowedUser(incoming(), email)
        && incoming().status == 'pending'
        && incoming().role == 'user'
        && (!('uid' in incoming()) || incoming().uid == request.auth.uid)
        && incoming().requestedAt == request.time
        && incoming().updatedAt == request.time
        && !('reviewedBy' in incoming())
      );

      allow update: if isAdmin()
        && isValidAllowedUser(incoming(), email)
        && incoming().email == existing().email
        && incoming().updatedAt == request.time
        && (
          request.auth.token.email.lower() != email
          || (incoming().role == 'admin' && incoming().status == 'approved')
        );

      allow delete: if isAdmin()
        && request.auth.token.email.lower() != email;
    }
  }
}
