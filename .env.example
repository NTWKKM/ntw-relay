# ==============================================================================
# NTW Relay — Environment Configuration
# ==============================================================================
# Optional: Standalone Firebase configuration overrides (by default, the app uses
# firebase-applet-config.json). Set these in GitHub Repository Variables only if
# you want to point GitHub Pages to a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# GitHub Pages Static Export (set automatically by .github/workflows/deploy.yml)
GITHUB_PAGES=false
NEXT_PUBLIC_BASE_PATH=/ntw-relay

# AI Studio platform variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
